# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
STAFF_ROLE_ID=
AUTOROLE_ID=

# Log ingressi/uscite membri + tracking inviti
# Due canali separati; in alternativa usa solo MEMBER_LOG_CHANNEL_ID per avere tutto in un canale.
MEMBER_JOIN_CHANNEL_ID=
MEMBER_LEAVE_CHANNEL_ID=
MEMBER_LOG_CHANNEL_ID=

# Ticket system
TICKET_CATEGORY_ID=
TRANSCRIPT_CHANNEL_ID=

# Setup-channels (messaggi preimpostati)
RULES_CHANNEL_ID=
ROSTER_CHANNEL_ID=
FACEIT_CHANNEL_ID=

# Notifiche live Twitch (lista streamer gestita con /twitch)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ANNOUNCE_CHANNEL_ID=
# everyone | here | <ID ruolo> | nessuna
TWITCH_MENTION=everyone
TWITCH_POLL_SECONDS=120

# Notifiche nuovi post sui social (feed gestiti con /social)
SOCIAL_ANNOUNCE_CHANNEL_ID=
# everyone | here | <ID ruolo> | nessuna
SOCIAL_MENTION=everyone
SOCIAL_POLL_SECONDS=300
SOCIAL_MAX_PER_CHECK=3

# Faceit Hub automation
FACEIT_API_KEY=
FACEIT_WEBHOOK_SECRET=
FACEIT_WEBHOOK_PORT=3000
TEMP_VC_CATEGORY_ID=

# Leaderboard
LEADERBOARD_CHANNEL_ID=
LEADERBOARD_TOP_N=10

# API di sola lettura per il sito (stessa porta dei webhook Faceit)
# API_TOKEN vuoto = API aperta; se lo imposti va mandato come header X-Api-Token.
API_ENABLED=true
API_TOKEN=
API_ALLOWED_ORIGIN=*
API_CACHE_SECONDS=30
API_RATE_LIMIT=120

# Database
DATABASE_PATH=./data/bot.db
